---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { profile, socials, education } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = profile.name,
  description = `${profile.name} is an AI engineer who ships full systems: computer vision models trained, served behind APIs and deployed. Final-year CS at VIT Bhopal.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: Astro.site?.toString(),
  alumniOf: { '@type': 'CollegeOrUniversity', name: education.school },
  sameAs: socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#efede8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Safety net: never leave the hero hidden if the motion script fails to load.
      setTimeout(function () { document.documentElement.classList.add('motion-ready'); }, 2500);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
