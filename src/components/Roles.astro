---
import Icon from './Icon.astro';
import { roles, socials } from '../data/site';

const linkedin = socials.find((s) => s.id === 'linkedin')!;
---

<section class="roles wrap" id="roles" aria-label="Roles I’m open to">
  <div class="roles__message">
    <p class="roles__lead" data-fade>{roles.lead}</p>
    <div class="roles__paras">
      {roles.message.map((para) => <p data-fade>{para}</p>)}
    </div>
  </div>

  <ol class="roles__list">
    {
      roles.items.map((r) => (
        <li class="roles__item" data-fade>
          {/* Flashcard: hover for 0.4s (or focus / tap on touch) to turn it over. Both faces are always readable by screen readers. */}
          <div class="flip" tabindex="0" data-flip>
            <div class="flip__inner">
              <div class="flip__face flip__front">
                <h3 class="display flip__title">{r.title}</h3>
              </div>
              <div class="flip__face flip__back">
                <p class="mono flip__label" aria-hidden="true">{r.title}</p>
                <p class="flip__body">{r.body}</p>
              </div>
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="roles__foot" data-fade>
    <a href={linkedin.href} class="roles__cta" target="_blank" rel="noopener noreferrer" aria-label="Let’s talk on LinkedIn (opens in a new tab)">
      <span class="display">Let’s talk</span>
      <Icon name="right" />
    </a>
  </div>
</section>

<script>
  // Hover devices flip in CSS after a 0.4s hover. Touch screens have no hover, so a tap flips instead.
  const touch = window.matchMedia('(hover: none)');
  document.querySelectorAll<HTMLElement>('[data-flip]').forEach((card) => {
    card.addEventListener('click', () => {
      if (touch.matches) card.classList.toggle('is-flipped');
    });
  });
</script>

<style>
  .roles {
    padding-block: clamp(96px, 14vw, 200px) 0;
  }

  .roles__message {
    padding-block: clamp(40px, 5vw, 72px) clamp(56px, 7vw, 104px);
    border-top: 1px solid var(--ink);
  }

  /* lead runs the full measure; the rest reads across three columns under it */
  .roles__lead {
    font-size: clamp(1.75rem, 3.7vw, 3.75rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .roles__paras {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px var(--gutter);
    margin-top: clamp(36px, 4.5vw, 64px);
  }

  .roles__paras p {
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
    line-height: 1.5;
    color: #2b2b2a;
    text-wrap: pretty;
  }

  .roles__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px var(--gutter);
  }

  .roles__item {
    display: flex;
  }

  /* ---- flip card ---- */
  .flip {
    width: 100%;
    perspective: 1400px;
    cursor: default;
  }

  .flip__inner {
    position: relative;
    display: grid;
    min-height: clamp(260px, 24vw, 340px);
    transform-style: preserve-3d;
    /* leaving the card turns it back straight away */
    transition: transform 0.6s var(--ease-in-out) 0s;
  }

  .flip__face {
    position: relative;
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 24px;
    padding: clamp(18px, 2vw, 28px);
    border: 1px solid var(--ink);
    border-radius: 14px;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip__front {
    background: var(--paper);
    transition: background 0.35s;
  }

  .flip__back {
    justify-content: space-between;
    background: var(--ink);
    color: var(--paper);
    transform: rotateY(180deg);
  }

  .flip__title {
    font-size: clamp(2.25rem, 3.8vw, 3.75rem);
    line-height: 0.9;
  }

  .flip__label {
    opacity: 0.7;
  }

  .flip__body {
    font-size: clamp(1.0625rem, 1.35vw, 1.3125rem);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .flip:focus-visible {
    outline: none;
  }

  .flip:focus-visible .flip__face {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  /* flipped: 0.4s hover on mouse devices, keyboard focus, or a tap on touch screens */
  @media (hover: hover) {
    .flip:hover .flip__front {
      background: var(--paper-deep);
    }

    .flip:hover .flip__inner {
      transform: rotateY(180deg);
      transition-delay: 0.4s;
    }
  }

  .flip:focus-visible .flip__inner,
  .flip.is-flipped .flip__inner {
    transform: rotateY(180deg);
  }

  /* No JS: no flipping, show both faces stacked. */
  :global(html:not(.js)) .flip__inner {
    display: flex;
    flex-direction: column;
    gap: 8px;
    transform: none !important;
  }

  :global(html:not(.js)) .flip__back {
    transform: none;
  }

  /* Reduced motion: swap faces with a fade instead of a 3D turn (the 0.4s hover delay still applies). */
  @media (prefers-reduced-motion: reduce) {
    .flip__inner,
    .flip:hover .flip__inner,
    .flip:focus-visible .flip__inner,
    .flip.is-flipped .flip__inner {
      transform: none !important;
    }

    .flip__face {
      transition: opacity 0s linear 0s;
    }

    .flip__back {
      transform: none;
      opacity: 0;
    }

    .flip:focus-visible .flip__back,
    .flip.is-flipped .flip__back {
      opacity: 1;
    }

    .flip:focus-visible .flip__front,
    .flip.is-flipped .flip__front {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) and (hover: hover) {
    .flip:hover .flip__back {
      opacity: 1;
      transition-delay: 0.4s;
    }

    .flip:hover .flip__front {
      opacity: 0;
      transition-delay: 0.4s;
    }
  }

  .roles__foot {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    gap: 24px;
    margin-top: clamp(56px, 7vw, 96px);
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }

  .roles__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 0.9;
  }

  .roles__cta :global(svg) {
    width: 0.7em;
    height: 0.7em;
    transition: transform 0.45s var(--ease);
  }

  .roles__cta:hover :global(svg),
  .roles__cta:focus-visible :global(svg) {
    transform: translateX(8px);
  }

  @media (max-width: 900px) {
    .roles__paras,
    .roles__list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .roles__foot {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>
