---
// "P" monogram: a geometric P on an ink tile, with a single square "pixel" as its signature.
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<svg
  class:list={['logo', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="7" fill="var(--ink, #161616)"></rect>
  <path
    fill="var(--paper, #efede8)"
    fill-rule="evenodd"
    d="M9 7h8a6 6 0 0 1 0 12h-4v6H9ZM13 11v4h4a2 2 0 0 0 0-4Z"></path>
  <rect x="19" y="21" width="4" height="4" fill="var(--paper, #efede8)"></rect>
</svg>

<style>
  .logo {
    flex: none;
    display: block;
  }
</style>
